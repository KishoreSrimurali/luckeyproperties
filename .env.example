# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.luckeyproperties.com

# ---- Lead delivery (at least one is required in production, otherwise the form returns a clear error) ----
# CRM / automation webhook (HubSpot workflow, Zoho, Salesforce, Make, Zapier…). Body is the full lead JSON.
LEAD_WEBHOOK_URL=
# Optional: HMAC-SHA256 of the raw body is sent in the x-luckey-signature header.
LEAD_WEBHOOK_SECRET=
# Email notifications + visitor acknowledgement via Resend (https://resend.com). Verify the sending domain first.
RESEND_API_KEY=
LEAD_FROM_EMAIL="LUCKEY Properties <enquiries@luckeyproperties.com>"
LEAD_NOTIFY_TO=info@luckeyproperties.com
# Append leads to .data/leads.ndjson (on by default outside production; only use on a persistent disk).
LEAD_FILE_SINK=

# ---- Spam protection (optional, recommended) — Cloudflare Turnstile ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Analytics (loaded only after cookie consent) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ---- Consultation booking (Calendly / Cal.com / HubSpot meetings). Empty = consultation request form ----
NEXT_PUBLIC_BOOKING_URL=

# ---- Regulatory credentials — publish only once verified on the DLD broker registry ----
NEXT_PUBLIC_RERA_ORN=
NEXT_PUBLIC_TRADE_LICENCE=

# ---- Content sign-off (build-time) ----
# Publish the four client testimonials once each client has confirmed permission.
NEXT_PUBLIC_TESTIMONIALS_APPROVED=false
# Staging only: shows content awaiting approval with a label and blocks indexing. Never true in production.
NEXT_PUBLIC_CONTENT_PREVIEW=false
